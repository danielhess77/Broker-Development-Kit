{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "bdk",

  "main": "src/index.ts",

  "compatibility_date": "2026-07-28",

  "observability": {
    "enabled": true
  },

  "upload_source_maps": true,

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "kv_namespaces": [
    {
      "binding": "BDK_AUTH",
      "id": "7a74d09ecb2d4e5aa8f9bc6aa7acb134"
    }
  ]

